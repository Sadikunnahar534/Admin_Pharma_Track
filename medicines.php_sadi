<?php
require_once '../includes/functions.php';
requireLogin();
require_once '../includes/db.php';
$conn = getConnection();
$pageTitle = 'Medicines';
$activePage = 'medicines';
$msg = ''; $err = '';

// Add Medicine
if ($_SERVER['REQUEST_METHOD']==='POST' && isset($_POST['action'])) {
    if ($_POST['action']==='add') {
        $name = $conn->real_escape_string(trim($_POST['name']));
        $generic = $conn->real_escape_string(trim($_POST['generic_name']));
        $cat = (int)$_POST['category_id'];
        $mfr = $conn->real_escape_string(trim($_POST['manufacturer']));
        $unit = $conn->real_escape_string(trim($_POST['unit']));
        $pp = (float)$_POST['purchase_price'];
        $sp = (float)$_POST['selling_price'];
        $stock = (int)$_POST['stock_quantity'];
        $min = (int)$_POST['min_stock_level'];
        $expiry = $conn->real_escape_string($_POST['expiry_date']);
        $batch = $conn->real_escape_string(trim($_POST['batch_number']));
        $desc = $conn->real_escape_string(trim($_POST['description']));
        if ($name && $sp >= 0) {
            $sql = "INSERT INTO medicines (name,generic_name,category_id,manufacturer,unit,purchase_price,selling_price,stock_quantity,min_stock_level,expiry_date,batch_number,description) VALUES ('$name','$generic'," . ($cat?$cat:'NULL') . ",'$mfr','$unit',$pp,$sp,$stock,$min," . ($expiry?"'$expiry'":'NULL') . ",'$batch','$desc')";
            if ($conn->query($sql)) $msg = "Medicine '$name' added successfully!";
            else $err = "Error: " . $conn->error;
        } else $err = "Name and selling price are required.";
    } elseif ($_POST['action']==='delete') {
        $id = (int)$_POST['id'];
        if ($conn->query("UPDATE medicines SET status='inactive' WHERE id=$id")) $msg = "Medicine removed.";
    } elseif ($_POST['action']==='edit') {
        $id=(int)$_POST['id']; $name=$conn->real_escape_string(trim($_POST['name']));
        $generic=$conn->real_escape_string(trim($_POST['generic_name'])); $cat=(int)$_POST['category_id'];
        $mfr=$conn->real_escape_string(trim($_POST['manufacturer'])); $unit=$conn->real_escape_string(trim($_POST['unit']));
        $pp=(float)$_POST['purchase_price']; $sp=(float)$_POST['selling_price'];
        $stock=(int)$_POST['stock_quantity']; $min=(int)$_POST['min_stock_level'];
        $expiry=$conn->real_escape_string($_POST['expiry_date']); $batch=$conn->real_escape_string(trim($_POST['batch_number']));
        if ($conn->query("UPDATE medicines SET name='$name',generic_name='$generic',category_id=".($cat?$cat:'NULL').",manufacturer='$mfr',unit='$unit',purchase_price=$pp,selling_price=$sp,stock_quantity=$stock,min_stock_level=$min,expiry_date=".($expiry?"'$expiry'":'NULL').",batch_number='$batch' WHERE id=$id"))
            $msg = "Medicine updated!";
        else $err = $conn->error;
    }
}

$search = $conn->real_escape_string(trim($_GET['q']??''));
$catFilter = (int)($_GET['cat']??0);
$where = "m.status='active'";
if ($search) $where .= " AND (m.name LIKE '%$search%' OR m.generic_name LIKE '%$search%' OR m.batch_number LIKE '%$search%')";
if ($catFilter) $where .= " AND m.category_id=$catFilter";
$medicines = $conn->query("SELECT m.*, c.name as cat_name FROM medicines m LEFT JOIN categories c ON m.category_id=c.id WHERE $where ORDER BY m.name ASC");
$categories = $conn->query("SELECT * FROM categories ORDER BY name");
$catsArr = []; $catRes = $conn->query("SELECT * FROM categories ORDER BY name");
while($r=$catRes->fetch_assoc()) $catsArr[$r['id']] = $r;

include '../includes/header.php';
?>
<?php if($msg): ?><div class="alert alert-success">✅ <?= htmlspecialchars($msg) ?></div><?php endif; ?>
<?php if($err): ?><div class="alert alert-danger">❌ <?= htmlspecialchars($err) ?></div><?php endif; ?>

<div class="page-header">
  <div><h1>💊 Medicines</h1><p>Manage your medicine inventory</p></div>
  <button class="btn btn-primary" onclick="document.getElementById('addModal').classList.add('active')">➕ Add Medicine</button>
</div>

<div class="search-bar">
  <form method="GET" style="display:flex;gap:12px;flex:1;">
    <div class="search-input-wrap" style="flex:1;">
      <span class="search-icon">🔍</span>
      <input type="text" name="q" placeholder="Search by name, generic, batch..." value="<?= htmlspecialchars($search) ?>">
    </div>
    <select name="cat" style="background:var(--card);border:1px solid var(--border);border-radius:10px;padding:11px 14px;color:var(--text);font-family:'DM Sans',sans-serif;outline:none;">
      <option value="">All Categories</option>
      <?php foreach($catsArr as $c): ?>
        <option value="<?= $c['id'] ?>" <?= $catFilter==$c['id']?'selected':'' ?>><?= htmlspecialchars($c['name']) ?></option>
      <?php endforeach; ?>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    <?php if($search||$catFilter): ?><a href="medicines.php" class="btn btn-outline">✕ Clear</a><?php endif; ?>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
  <table>
    <thead><tr><th>#</th><th>Medicine</th><th>Category</th><th>Stock</th><th>Price</th><th>Expiry</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
    <?php $i=1; while($row=$medicines->fetch_assoc()):
      $status = getExpiryStatus($row['expiry_date']);
      $lowstk = $row['stock_quantity'] <= $row['min_stock_level'];
    ?>
      <tr>
        <td style="color:var(--muted);font-size:12px;"><?= $i++ ?></td>
        <td>
          <strong><?= htmlspecialchars($row['name']) ?></strong>
          <?php if($row['generic_name']): ?><br><span style="color:var(--muted);font-size:12px;"><?= htmlspecialchars($row['generic_name']) ?></span><?php endif; ?>
          <?php if($row['batch_number']): ?><br><span style="color:var(--accent2);font-size:11px;font-family:'Space Mono',monospace;"><?= htmlspecialchars($row['batch_number']) ?></span><?php endif; ?>
        </td>
        <td><?= htmlspecialchars($row['cat_name']??'—') ?></td>
        <td>
          <span style="font-family:'Space Mono',monospace;font-weight:700;color:<?= $lowstk?'var(--danger)':'var(--success)' ?>;"><?= number_format($row['stock_quantity']) ?></span>
          <span style="color:var(--muted);font-size:11px;"> <?= htmlspecialchars($row['unit']) ?></span>
          <?php if($lowstk): ?><br><span class="badge badge-danger" style="font-size:10px;">LOW STOCK</span><?php endif; ?>
        </td>
        <td>
          <span style="font-size:12px;color:var(--muted);">Buy: <?= formatCurrency($row['purchase_price']) ?></span><br>
          <strong><?= formatCurrency($row['selling_price']) ?></strong>
        </td>
        <td>
          <?php if($row['expiry_date']): ?>
            <span style="font-family:'Space Mono',monospace;font-size:12px;"><?= $row['expiry_date'] ?></span>
            <?php $days=getDaysUntilExpiry($row['expiry_date']); ?>
            <?php if($days!==null): ?>
              <br><span class="badge <?= $status==='expired'?'badge-danger':($status==='critical'?'badge-danger':'badge-warning') ?>" style="font-size:10px;">
                <?= $days<0?'Expired':($days==0?'Today!':"$days days") ?>
              </span>
            <?php endif; ?>
          <?php else: ?>—<?php endif; ?>
        </td>
        <td><span class="badge <?= $status==='good'||$status==='none'?'badge-success':($status==='expired'?'badge-danger':'badge-warning') ?>"><?= ucfirst($status==='none'?'Good':$status) ?></span></td>
        <td>
          <div style="display:flex;gap:6px;">
            <button class="btn btn-outline btn-sm" onclick='openEdit(<?= json_encode($row) ?>)'>✏️</button>
            <form method="POST" onsubmit="return confirm('Remove this medicine?');" style="display:inline;">
              <input type="hidden" name="action" value="delete">
              <input type="hidden" name="id" value="<?= $row['id'] ?>">
              <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
            </form>
          </div>
        </td>
      </tr>
    <?php endwhile; ?>
    </tbody>
  </table>
  </div>
</div>

<!-- Add Modal -->
<div class="modal-overlay" id="addModal">
  <div class="modal">
    <div class="modal-close" onclick="this.closest('.modal-overlay').classList.remove('active')">✕</div>
    <h3>➕ Add New Medicine</h3>
    <form method="POST">
      <input type="hidden" name="action" value="add">
      <div class="form-grid">
        <div class="form-group"><label>Medicine Name *</label><input type="text" name="name" required placeholder="e.g. Napa 500mg"></div>
        <div class="form-group"><label>Generic Name</label><input type="text" name="generic_name" placeholder="e.g. Paracetamol"></div>
        <div class="form-group"><label>Category</label>
          <select name="category_id">
            <option value="">Select Category</option>
            <?php foreach($catsArr as $c): ?><option value="<?= $c['id'] ?>"><?= htmlspecialchars($c['name']) ?></option><?php endforeach; ?>
          </select>
        </div>
        <div class="form-group"><label>Manufacturer</label><input type="text" name="manufacturer" placeholder="e.g. Beximco Pharma"></div>
        <div class="form-group"><label>Unit</label>
          <select name="unit"><option value="pcs">Pieces (pcs)</option><option value="strip">Strip</option><option value="bottle">Bottle</option><option value="tube">Tube</option><option value="box">Box</option><option value="vial">Vial</option></select>
        </div>
        <div class="form-group"><label>Purchase Price (৳) *</label><input type="number" name="purchase_price" step="0.01" min="0" value="0" required></div>
        <div class="form-group"><label>Selling Price (৳) *</label><input type="number" name="selling_price" step="0.01" min="0" value="0" required></div>
        <div class="form-group"><label>Opening Stock</label><input type="number" name="stock_quantity" min="0" value="0"></div>
        <div class="form-group"><label>Min Stock Level</label><input type="number" name="min_stock_level" min="0" value="10"></div>
        <div class="form-group"><label>Expiry Date</label><input type="date" name="expiry_date"></div>
        <div class="form-group"><label>Batch Number</label><input type="text" name="batch_number" placeholder="e.g. BX2024001"></div>
      </div>
      <div class="form-group"><label>Description</label><textarea name="description" rows="2" placeholder="Optional notes..."></textarea></div>
      <button type="submit" class="btn btn-primary">Save Medicine</button>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal">
    <div class="modal-close" onclick="this.closest('.modal-overlay').classList.remove('active')">✕</div>
    <h3>✏️ Edit Medicine</h3>
    <form method="POST">
      <input type="hidden" name="action" value="edit">
      <input type="hidden" name="id" id="edit_id">
      <div class="form-grid">
        <div class="form-group"><label>Medicine Name *</label><input type="text" name="name" id="edit_name" required></div>
        <div class="form-group"><label>Generic Name</label><input type="text" name="generic_name" id="edit_generic"></div>
        <div class="form-group"><label>Category</label>
          <select name="category_id" id="edit_cat">
            <option value="">Select Category</option>
            <?php foreach($catsArr as $c): ?><option value="<?= $c['id'] ?>"><?= htmlspecialchars($c['name']) ?></option><?php endforeach; ?>
          </select>
        </div>
        <div class="form-group"><label>Manufacturer</label><input type="text" name="manufacturer" id="edit_mfr"></div>
        <div class="form-group"><label>Unit</label>
          <select name="unit" id="edit_unit"><option value="pcs">pcs</option><option value="strip">Strip</option><option value="bottle">Bottle</option><option value="tube">Tube</option><option value="box">Box</option><option value="vial">Vial</option></select>
        </div>
        <div class="form-group"><label>Purchase Price (৳)</label><input type="number" name="purchase_price" id="edit_pp" step="0.01" min="0"></div>
        <div class="form-group"><label>Selling Price (৳)</label><input type="number" name="selling_price" id="edit_sp" step="0.01" min="0"></div>
        <div class="form-group"><label>Stock Qty</label><input type="number" name="stock_quantity" id="edit_stock" min="0"></div>
        <div class="form-group"><label>Min Stock</label><input type="number" name="min_stock_level" id="edit_min" min="0"></div>
        <div class="form-group"><label>Expiry Date</label><input type="date" name="expiry_date" id="edit_expiry"></div>
        <div class="form-group"><label>Batch Number</label><input type="text" name="batch_number" id="edit_batch"></div>
      </div>
      <button type="submit" class="btn btn-primary">Update Medicine</button>
    </form>
  </div>
</div>

<script>
function openEdit(d) {
  document.getElementById('edit_id').value = d.id;
  document.getElementById('edit_name').value = d.name;
  document.getElementById('edit_generic').value = d.generic_name||'';
  document.getElementById('edit_cat').value = d.category_id||'';
  document.getElementById('edit_mfr').value = d.manufacturer||'';
  document.getElementById('edit_unit').value = d.unit||'pcs';
  document.getElementById('edit_pp').value = d.purchase_price;
  document.getElementById('edit_sp').value = d.selling_price;
  document.getElementById('edit_stock').value = d.stock_quantity;
  document.getElementById('edit_min').value = d.min_stock_level;
  document.getElementById('edit_expiry').value = d.expiry_date||'';
  document.getElementById('edit_batch').value = d.batch_number||'';
  document.getElementById('editModal').classList.add('active');
}
</script>
<?php include '../includes/footer.php'; $conn->close(); ?>
