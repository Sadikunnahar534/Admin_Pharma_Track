<?php
require_once '../includes/functions.php';
requireLogin();
require_once '../includes/db.php';
$conn = getConnection();
$pageTitle = 'Low Stock Alert';
$activePage = 'lowstock';
$msg = ''; $err = '';

if ($_SERVER['REQUEST_METHOD']==='POST' && isset($_POST['action']) && $_POST['action']==='restock') {
    $id=(int)$_POST['medicine_id'];
    $qty=(int)$_POST['qty'];
    $notes=$conn->real_escape_string(trim($_POST['notes']??''));
    if ($qty>0) {
        $conn->query("UPDATE medicines SET stock_quantity=stock_quantity+$qty WHERE id=$id");
        $conn->query("INSERT INTO stock_adjustments (medicine_id,adjustment_type,quantity,notes) VALUES ($id,'purchase',$qty,'$notes')");
        $msg = "Stock updated successfully!";
    } else $err = "Quantity must be greater than 0.";
}

$meds = $conn->query("SELECT m.*, c.name as cat_name FROM medicines m LEFT JOIN categories c ON m.category_id=c.id WHERE m.status='active' AND m.stock_quantity <= m.min_stock_level ORDER BY (m.stock_quantity/m.min_stock_level) ASC");

include '../includes/header.php';
?>
<?php if($msg): ?><div class="alert alert-success">✅ <?= htmlspecialchars($msg) ?></div><?php endif; ?>
<?php if($err): ?><div class="alert alert-danger">❌ <?= htmlspecialchars($err) ?></div><?php endif; ?>

<div class="page-header">
  <div><h1>📉 Low Stock Alert</h1><p>Medicines below minimum stock level</p></div>
</div>

<div class="card">
  <div class="table-wrap">
  <table>
    <thead><tr><th>Medicine</th><th>Category</th><th>Current Stock</th><th>Min Level</th><th>Shortage</th><th>Selling Price</th><th>Action</th></tr></thead>
    <tbody>
    <?php while($row=$meds->fetch_assoc()):
      $shortage = $row['min_stock_level'] - $row['stock_quantity'];
      $pct = $row['min_stock_level']>0 ? ($row['stock_quantity']/$row['min_stock_level'])*100 : 0;
    ?>
      <tr>
        <td>
          <strong><?= htmlspecialchars($row['name']) ?></strong><br>
          <span style="color:var(--muted);font-size:12px;"><?= htmlspecialchars($row['generic_name']??'') ?></span>
        </td>
        <td><?= htmlspecialchars($row['cat_name']??'—') ?></td>
        <td>
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-family:'Space Mono',monospace;font-weight:700;color:<?= $row['stock_quantity']==0?'var(--danger)':'var(--warning)' ?>;"><?= $row['stock_quantity'] ?></span>
            <div style="width:80px;height:6px;background:var(--surface);border-radius:3px;overflow:hidden;">
              <div style="height:100%;width:<?= min(100,$pct) ?>%;background:<?= $pct<50?'var(--danger)':'var(--warning)' ?>;border-radius:3px;"></div>
            </div>
          </div>
          <?php if($row['stock_quantity']==0): ?><span class="badge badge-danger" style="font-size:10px;margin-top:4px;">OUT OF STOCK</span><?php endif; ?>
        </td>
        <td style="font-family:'Space Mono',monospace;"><?= $row['min_stock_level'] ?></td>
        <td><span class="badge badge-danger">-<?= $shortage ?> units</span></td>
        <td><?= formatCurrency($row['selling_price']) ?></td>
        <td>
          <button class="btn btn-primary btn-sm" onclick='openRestock(<?= json_encode(["id"=>$row["id"],"name"=>$row["name"],"shortage"=>$shortage]) ?>)'>📦 Restock</button>
        </td>
      </tr>
    <?php endwhile; ?>
    </tbody>
  </table>
  </div>
</div>

<!-- Restock Modal -->
<div class="modal-overlay" id="restockModal">
  <div class="modal" style="max-width:400px;">
    <div class="modal-close" onclick="this.closest('.modal-overlay').classList.remove('active')">✕</div>
    <h3>📦 Restock Medicine</h3>
    <p id="restock_name" style="color:var(--accent);font-weight:600;margin-bottom:20px;font-size:15px;"></p>
    <form method="POST">
      <input type="hidden" name="action" value="restock">
      <input type="hidden" name="medicine_id" id="restock_id">
      <div class="form-group"><label>Quantity to Add *</label><input type="number" name="qty" id="restock_qty" min="1" required placeholder="Enter quantity"></div>
      <div class="form-group"><label>Notes</label><textarea name="notes" rows="2" placeholder="Purchase order, supplier info..."></textarea></div>
      <button type="submit" class="btn btn-primary">Update Stock</button>
    </form>
  </div>
</div>

<script>
function openRestock(d) {
  document.getElementById('restock_id').value = d.id;
  document.getElementById('restock_name').textContent = d.name;
  document.getElementById('restock_qty').value = d.shortage > 0 ? d.shortage : 1;
  document.getElementById('restockModal').classList.add('active');
}
</script>
<?php include '../includes/footer.php'; $conn->close(); ?>
